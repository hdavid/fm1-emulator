#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
set -eu
if [ "$#" -ne 1 ]; then
    echo 'usage: ./emulator <firmware.fwsc|application.elf|application.bin>' >&2
    echo 'example: ./emulator build/display/firmware.elf' >&2
    exit 2
fi
case "$1" in
    /*) firmware=$1 ;;
    *) firmware=$PWD/$1 ;;
esac
project=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$project"
mise exec -- cargo build --quiet --locked --release \
    --manifest-path rust-emulator/Cargo.toml --target-dir rust-emulator/target \
    --features gui --bin fm1-ui
binary="$project/rust-emulator/target/release/fm1-ui"
if [ "$(uname -s)" = Darwin ]; then
    # A bundle gives macOS a stable application identity and Retina support.
    app="$project/rust-emulator/target/release/FM-1 Emulator.app/Contents"
    mkdir -p "$app/MacOS"
    cp rust-emulator/macos/Info.plist "$app/Info.plist"
    if [ ! -f "$app/MacOS/fm1-ui" ] || [ "$binary" -nt "$app/MacOS/fm1-ui" ]; then
        cp "$binary" "$app/MacOS/fm1-ui.new"
        mv -f "$app/MacOS/fm1-ui.new" "$app/MacOS/fm1-ui"
    fi
    binary="$app/MacOS/fm1-ui"
fi
exec "$binary" "$firmware"
